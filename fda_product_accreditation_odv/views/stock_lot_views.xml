<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_lot_form_inherit_permit_management" model="ir.ui.view">
        <field name="name">stock.lot.form.permit.management</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='description']" position="after">
                <group string="Permits / Accreditation">
                    <group>
                        <field name="permit_lot_id"/>
                        <field name="permit_registration_date"/>
                        <field name="permit_expiry_date"/>
                        <field name="permit_state"/>
                    </group>
                    <group>
                        <field name="permit_ids" nolabel="1">
                            <list decoration-danger="state == 'expired'" decoration-warning="state == 'warning'" decoration-success="state == 'valid'">
                                <field name="name"/>
                                <field name="permit_number"/>
                                <field name="permit_type"/>
                                <field name="product_id"/>
                                <field name="registration_date"/>
                                <field name="expiry_date"/>
                                <field name="days_remaining"/>
                                <field name="state"/>
                            </list>
                        </field>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
