<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_permit_lot_list" model="ir.ui.view">
        <field name="name">product.permit.lot.list</field>
        <field name="model">product.permit.lot</field>
        <field name="arch" type="xml">
            <list decoration-danger="state == 'expired'" decoration-warning="state == 'warning'" decoration-success="state == 'valid'">
                <field name="name"/>
                <field name="product_id"/>
                <field name="lot_id"/>
                <field name="permit_number"/>
                <field name="permit_type"/>
                <field name="registration_date"/>
                <field name="expiry_date"/>
                <field name="days_remaining"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_product_permit_lot_form" model="ir.ui.view">
        <field name="name">product.permit.lot.form</field>
        <field name="model">product.permit.lot</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="product_id"/>
                            <field name="lot_id" domain="[('product_id','=', product_id)]"/>
                            <field name="permit_number"/>
                            <field name="permit_type"/>
                        </group>
                        <group>
                            <field name="registration_date"/>
                            <field name="expiry_date"/>
                            <field name="warning_days"/>
                            <field name="days_remaining"/>
                            <field name="state"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_product_permit_lot" model="ir.actions.act_window">
        <field name="name">FDA Product Permits</field>
        <field name="res_model">product.permit.lot</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_fda_product_permit_root" name="FDA Product Permits" parent="stock.menu_stock_root" sequence="30"/>
    <menuitem id="menu_product_permit_lot" name="Permit Lots" parent="menu_fda_product_permit_root" action="action_product_permit_lot" sequence="10"/>
</odoo>
