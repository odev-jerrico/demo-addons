<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_inherit_permit_management" model="ir.ui.view">
        <field name="name">product.template.form.permit.management</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_information']" position="after">
                <page string="Permits / Accreditation">
                    <group>
                        <group string="Current Permit Summary">
                            <field name="permit_registration_date"/>
                            <field name="permit_expiry_date"/>
                            <field name="permit_state"/>
                            <field name="permit_days_remaining"/>
                        </group>
                        <group string="Alerts">
                            <field name="has_expired_permit"/>
                            <field name="has_near_expiry_permit"/>
                        </group>
                    </group>
                    <field name="permit_ids" context="{'default_product_tmpl_id': id, 'default_product_id': product_variant_id}">
                        <list decoration-danger="state == 'expired'" decoration-warning="state == 'warning'" decoration-success="state == 'valid'">
                            <field name="name"/>
                            <field name="permit_number"/>
                            <field name="permit_type"/>
                            <field name="lot_id"/>
                            <field name="registration_date"/>
                            <field name="expiry_date"/>
                            <field name="days_remaining"/>
                            <field name="state"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="product_product_form_inherit_permit_management" model="ir.ui.view">
        <field name="name">product.product.form.permit.management</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_information']" position="after">
                <page string="Permits / Accreditation">
                    <group>
                        <group string="Current Permit Summary">
                            <field name="permit_registration_date"/>
                            <field name="permit_expiry_date"/>
                            <field name="permit_state"/>
                            <field name="permit_days_remaining"/>
                        </group>
                        <group string="Alerts">
                            <field name="has_expired_permit"/>
                            <field name="has_near_expiry_permit"/>
                        </group>
                    </group>
                    <field name="permit_ids" context="{'default_product_tmpl_id': product_tmpl_id, 'default_product_id': id}">
                        <list decoration-danger="state == 'expired'" decoration-warning="state == 'warning'" decoration-success="state == 'valid'">
                            <field name="name"/>
                            <field name="permit_number"/>
                            <field name="permit_type"/>
                            <field name="lot_id"/>
                            <field name="registration_date"/>
                            <field name="expiry_date"/>
                            <field name="days_remaining"/>
                            <field name="state"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="sale_order_form_order_line_inherit_permit_columns" model="ir.ui.view">
        <field name="name">sale.order.form.order.line.permit.columns</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='discount']" position="after">
                <field name="permit_registration_date" optional="hide"/>
                <field name="permit_expiry_date" optional="hide"/>
                <field name="permit_state" optional="hide"/>
                <field name="permit_days_remaining" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="account_move_line_tree_inherit_permit_columns" model="ir.ui.view">
        <field name="name">account.move.line.permit.columns</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='deductible_amount']" position="after">
                <field name="permit_registration_date" optional="hide"/>
                <field name="permit_expiry_date" optional="hide"/>
                <field name="permit_state" optional="hide"/>
                <field name="permit_days_remaining" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="account_move_form_line_ids_inherit_permit_columns" model="ir.ui.view">
        <field name="name">account.move.form.line.ids.permit.columns</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='line_ids']/list/field[@name='tax_tag_ids']" position="after">
                <field name="permit_registration_date" optional="hide"/>
                <field name="permit_expiry_date" optional="hide"/>
                <field name="permit_state" optional="hide"/>
                <field name="permit_days_remaining" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
