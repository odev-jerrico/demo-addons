<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_approval_level_view_form_branch" model="ir.ui.view">
        <field name="name">purchase.approval.level.view.form.branch</field>
        <field name="model">purchase.approval.level</field>
        <field name="inherit_id" ref="purchase_approval_matrix_odv.purchase_approval_level_view_form"/>
        <field name="arch" type="xml">
            <field name="department_ids" position="after">
                <field name="branch_ids" widget="many2many_tags" options="{'no_create': 1, 'no_create_edit': 1}"/>
            </field>
        </field>
    </record>

    <record id="purchase_approval_level_view_list_branch" model="ir.ui.view">
        <field name="name">purchase.approval.level.view.list.branch</field>
        <field name="model">purchase.approval.level</field>
        <field name="inherit_id" ref="purchase_approval_matrix_odv.purchase_approval_level_view_view_list"/>
        <field name="arch" type="xml">
            <field name="department_ids" position="after">
                <field name="branch_ids" widget="many2many_tags" optional="show"/>
            </field>
        </field>
    </record>
</odoo>
