<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_form_view_inherit_company_split" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.company.split</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_confirm'][1]" position="before">
                <button name="action_open_company_split_wizard" type="object"
                        string="Split Sales Order" class="btn-secondary"
                        invisible="state not in ['draft', 'sent'] or split_sale_order_count != 0"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_split_sale_orders" type="object" class="oe_stat_button"
                        icon="fa-code-fork" invisible="split_sale_order_count == 0">
                    <field name="split_sale_order_count" widget="statinfo" string="Split Orders"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='client_order_ref']" position="after">
                <field name="origin_sale_order_id" readonly="1" invisible="not origin_sale_order_id"/>
            </xpath>
        </field>
    </record>
</odoo>
