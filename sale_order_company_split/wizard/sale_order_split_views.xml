<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_split_wizard_form" model="ir.ui.view">
        <field name="name">sale.order.split.wizard.form</field>
        <field name="model">sale.order.split.wizard</field>
        <field name="arch" type="xml">
            <form string="Split Sales Order">
                <group>
                    <field name="source_sale_order_id"/>
                    <field name="source_company_id"/>
                    <field name="can_override" invisible="1"/>
                </group>
                <field name="split_detail_ids" nolabel="1">
                    <list create="0" delete="0" editable="bottom" open_form_view="0">
                        <field name="can_override" column_invisible="1"/>
                        <field name="owning_company_id" readonly="not can_override"/>
                        <field name="original_owning_company_id" column_invisible="1" force_save="1"/>
                        <field name="sale_order_line_ids" column_invisible="1" force_save="1"/>
                        <field name="source_line_ids" column_invisible="1" force_save="1"/>
                        <field name="product_summary"/>
                        <field name="quantity"/>
                        <field name="subtotal"/>
                        <field name="keep_on_original_order"/>
                    </list>
                </field>
                <footer>
                    <button name="action_split" type="object" string="Split Sales Order" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
