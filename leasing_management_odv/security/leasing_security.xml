<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_leasing" model="res.groups.privilege">
        <field name="name">Leasing</field>
        <field name="description">Leasing management permissions.</field>
        <field name="category_id" ref="base.module_category_sales"/>
        <field name="sequence">65</field>
    </record>

    <record id="group_leasing_user" model="res.groups">
        <field name="name">Leasing User</field>
        <field name="privilege_id" ref="leasing_management_odv.res_groups_privilege_leasing"/>
    </record>

    <record id="group_leasing_manager" model="res.groups">
        <field name="name">Leasing Manager</field>
        <field name="privilege_id" ref="leasing_management_odv.res_groups_privilege_leasing"/>
        <field name="implied_ids" eval="[(4, ref('leasing_management_odv.group_leasing_user'))]"/>
    </record>

    <record id="rule_maintenance_portal_own" model="ir.rule">
        <field name="name">Portal Own Maintenance Requests</field>
        <field name="model_id" ref="model_leasing_maintenance_request"/>
        <field name="domain_force">[('tenant_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    </record>
</odoo>
