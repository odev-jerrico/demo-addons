<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_leasing_maintenance_request_list" model="ir.ui.view">
        <field name="name">leasing.maintenance.request.list</field>
        <field name="model">leasing.maintenance.request</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="request_date"/>
                <field name="tenant_id"/>
                <field name="unit_id"/>
                <field name="priority"/>
                <field name="assigned_user_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_leasing_maintenance_request_form" model="ir.ui.view">
        <field name="name">leasing.maintenance.request.form</field>
        <field name="model">leasing.maintenance.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" type="object" string="Start" invisible="state != 'new'"/>
                    <button name="action_resolve" type="object" string="Resolve" invisible="state not in ('new', 'in_progress')" class="btn-primary"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ('resolved', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,in_progress,resolved,cancelled"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="tenant_id"/>
                            <field name="unit_id"/>
                            <field name="contract_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="request_date"/>
                            <field name="priority"/>
                            <field name="assigned_user_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                        <field name="resolution_notes" invisible="state not in ('resolved', 'cancelled')"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_leasing_maintenance_request" model="ir.actions.act_window">
        <field name="name">Maintenance Requests</field>
        <field name="res_model">leasing.maintenance.request</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
