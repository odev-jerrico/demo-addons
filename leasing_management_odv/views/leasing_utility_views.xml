<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_leasing_utility_meter_list" model="ir.ui.view">
        <field name="name">leasing.utility.meter.list</field>
        <field name="model">leasing.utility.meter</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="unit_id"/>
                <field name="meter_type"/>
                <field name="rate"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_leasing_utility_meter_form" model="ir.ui.view">
        <field name="name">leasing.utility.meter.form</field>
        <field name="model">leasing.utility.meter</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="unit_id"/>
                        </group>
                        <group>
                            <field name="meter_type"/>
                            <field name="unit_of_measure"/>
                            <field name="rate"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_leasing_utility_meter" model="ir.actions.act_window">
        <field name="name">Utility Meters</field>
        <field name="res_model">leasing.utility.meter</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_leasing_utility_reading_list" model="ir.ui.view">
        <field name="name">leasing.utility.reading.list</field>
        <field name="model">leasing.utility.reading</field>
        <field name="arch" type="xml">
            <list>
                <field name="reading_date"/>
                <field name="meter_id"/>
                <field name="meter_type"/>
                <field name="unit_id"/>
                <field name="previous_reading"/>
                <field name="current_reading"/>
                <field name="consumption"/>
                <field name="rate_snapshot"/>
                <field name="amount"/>
                <field name="contract_id"/>
                <field name="billed"/>
                <button name="action_generate_utility_invoice" string="Generate Invoice" type="object" invisible="billed"/>
            </list>
        </field>
    </record>

    <record id="view_leasing_utility_reading_search" model="ir.ui.view">
        <field name="name">leasing.utility.reading.search</field>
        <field name="model">leasing.utility.reading</field>
        <field name="arch" type="xml">
            <search>
                <field name="meter_id"/>
                <field name="meter_type"/>
                <field name="unit_id"/>
                <field name="contract_id"/>
                <group>
                    <filter name="group_by_meter_type" string="Meter Type" context="{'group_by': 'meter_type'}"/>
                    <filter name="group_by_meter" string="Meter" context="{'group_by': 'meter_id'}"/>
                    <filter name="group_by_unit" string="Unit" context="{'group_by': 'unit_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_leasing_utility_reading_form" model="ir.ui.view">
        <field name="name">leasing.utility.reading.form</field>
        <field name="model">leasing.utility.reading</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_generate_utility_invoice" type="object" string="Generate Invoice" invisible="billed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button type="object" class="oe_stat_button" name="action_view_invoice" icon="fa-file-text-o" invisible="not invoice_id">
                            <field name="utility_invoice_count" string="Invoice" widget="statinfo"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="meter_id" readonly="billed"/>
                            <field name="unit_id" readonly="1"/>
                            <field name="reading_date" readonly="billed"/>
                        </group>
                        <group>
                            <field name="previous_reading" readonly="billed"/>
                            <field name="current_reading" readonly="billed"/>
                            <field name="consumption" readonly="1"/>
                            <field name="rate_snapshot" readonly="billed"/>
                            <field name="amount" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="contract_id" readonly="billed" domain="[('unit_id', '=', unit_id)]"/>
                        <field name="billed" readonly="1"/>
                        <field name="invoice_id" readonly="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_leasing_utility_reading" model="ir.actions.act_window">
        <field name="name">Utility Readings</field>
        <field name="res_model">leasing.utility.reading</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_leasing_utility_reading_search"/>
    </record>
</odoo>
